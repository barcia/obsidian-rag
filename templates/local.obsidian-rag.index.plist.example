<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.obsidian-rag.index</string>

    <key>ProgramArguments</key>
    <array>
        <string>fnm</string>
        <string>exec</string>
        <string>--using=24</string>
        <string>node</string>
        <string>{HOME}/.local/bin/obsidian-rag/indexer.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{HOME}/.local/opt/obsidian-rag</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OPENROUTER_API_KEY</key>
        <string>{YOUR_API_KEY}</string>
        <key>OBSIDIAN_VAULT_PATH</key>
        <string>{OBSIDIAN_VAULT_PATH}</string>
    </dict>

    <key>WatchPaths</key>
    <array>
        <string>{OBSIDIAN_VAULT_PATH}</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>{HOME}/Library/Logs/obsidian-rag.log</string>
    <key>StandardErrorPath</key>
    <string>{HOME}/Library/Logs/obsidian-rag.error.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
