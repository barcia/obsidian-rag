# OpenRouter API key (required)
OPENROUTER_API_KEY=sk-or-tu-api-key

# Path to your Obsidian vault
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian

# Path where LanceDB will be stored
DATA_PATH=~/.local/share/obsidian-rag

# Path for application logs (if not set, logs go to stdout)
# LOG_PATH=~/Library/Logs/obsidian-rag/indexer.log
