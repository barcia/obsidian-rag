<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.obsidian-rag.index</string>

    <!-- Set PATH to use a specific Node version (e.g., via fnm) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{YOUR_NODE_BIN_PATH}:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <!-- Example: /Users/ivan/.local/share/fnm/node-versions/v24.8.0/installation/bin -->

    <key>ProgramArguments</key>
    <array>
        <string>node</string>
        <string>{YOUR_PROJECT_PATH}/dist/indexer.js</string>
    </array>
    <!-- Run `pnpm build` first to transpile TypeScript to dist/ -->

    <key>WorkingDirectory</key>
    <string>{YOUR_PROJECT_PATH}</string>

    <key>WatchPaths</key>
    <array>
        <string>{YOUR_OBSIDIAN_VAULT_PATH}</string>
    </array>

    <key>ThrottleInterval</key>
    <integer>600</integer>

    <key>StandardOutPath</key>
    <string>{YOUR_HOME}/Library/Logs/obsidian-rag.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{YOUR_HOME}/Library/Logs/obsidian-rag.stderr.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
