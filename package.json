{
  "name": "obsidian-rag",
  "version": "1.2.0",
  "description": "MCP server for semantic search in Obsidian vault using LanceDB",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsc",
    "server-mcp": "node dist/server-mcp.js",
    "index": "node dist/indexer.js",
    "dev:server-mcp": "npx tsx src/server-mcp.ts",
    "dev:index": "npx tsx src/indexer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "apache-arrow": "^17.0.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.73.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}
