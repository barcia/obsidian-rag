{
  "name": "obsidian-rag",
  "version": "1.4.0",
  "description": "MCP server for semantic search in Obsidian vault using LanceDB",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "server-mcp": "node dist/server-mcp.js",
    "index": "node dist/indexer.js",
    "dev:server-mcp": "npx tsx src/server-mcp.ts",
    "dev:index": "npx tsx src/indexer.ts",
    "reindex": "node dist/reindexer.js",
    "dev:reindex": "npx tsx src/reindexer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.23.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "apache-arrow": "^21.1.0",
    "glob": "^13.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.16.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
