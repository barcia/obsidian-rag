{
  "name": "obsidian-rag",
  "version": "1.0.0",
  "description": "MCP server for semantic search in Obsidian vault using LanceDB",
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "mcp-server": "bun run src/cli.ts mcp-server",
    "index": "bun run src/cli.ts index",
    "reindex": "bun run src/cli.ts reindex",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/obsidian-rag"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "apache-arrow": "^17.0.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  }
}
